rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCoachOrAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin'];
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && resource.data.role in ['coach', 'admin'];
      allow read: if request.auth != null
        && resource.data.coachId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    match /inviteCodes/{code} {
      // Single-doc lookup by known code is public (needed before Auth signup);
      // listing the collection to harvest codes is forbidden.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy.hasAll(resource.data.usedBy)
          && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
        )
      );
    }

    match /coachInvites/{token} {
      // Single-doc lookup by known token is public (needed before Auth signup);
      // listing the collection to harvest tokens is forbidden.
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
    }

    match /videos/{videoId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.coachId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.coachId == request.auth.uid;
      allow read: if request.auth != null
        && request.auth.uid in resource.data.studentIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.studentIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        && request.resource.data.viewedBy.hasAll(resource.data.viewedBy)
        && request.resource.data.viewedBy.size() == resource.data.viewedBy.size() + 1;

      match /annotations/{annotationId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }

      match /voiceover/{docId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }

      match /comments/{commentId} {
        allow read, create: if isAdmin();
        allow read, create: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
      }

      match /reactions/{userId} {
        allow read, write: if isAdmin();
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
        allow write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }
    }

    // Sessions and bookings — in-app calendar retired (external booking via Play by Point).
    // Reads remain for authenticated users (coach dashboards still count past bookings for
    // lesson stats); writes are locked to admins so nobody can create/modify/delete records.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 1-to-1 messaging threads
    match /threads/{threadId} {
      // The thread doc is readable/writable by the coach or the athlete in the thread
      allow read, write: if request.auth != null
        && (
          resource.data.coachId == request.auth.uid
          || resource.data.athleteId == request.auth.uid
        );
      // Allow create when the doc doesn't exist yet — validate the ids match the caller
      allow create: if request.auth != null
        && (
          request.resource.data.coachId == request.auth.uid
          || request.resource.data.athleteId == request.auth.uid
        );

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/threads/$(threadId)).data.coachId == request.auth.uid
            || get(/databases/$(database)/documents/threads/$(threadId)).data.athleteId == request.auth.uid
          );
        allow create: if request.auth != null
          && (
            get(/databases/$(database)/documents/threads/$(threadId)).data.coachId == request.auth.uid
            || get(/databases/$(database)/documents/threads/$(threadId)).data.athleteId == request.auth.uid
          )
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // App-wide settings — readable by any authenticated user, writable only by admins
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // In-app notifications — each user can only read/update their own; creates are
    // constrained so an authed user can't spoof a notification to themselves and
    // must use a known type. Recipient must differ from caller (nobody legitimately
    // notifies themselves — this blocks self-spam and abusive impersonation of self).
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.type in ['new_video', 'new_message', 'new_comment', 'booking', 'booking_approved', 'booking_declined']
        && request.resource.data.read == false;
    }

  }
}
