rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCoachOrAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin'];
    }

    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // Coaches and admins can read all user profiles (student selector, dashboard)
      allow read: if isCoachOrAdmin();
    }

    match /inviteCodes/{code} {
      // Anyone can read a code to validate it — links are meant to be shared
      allow read: if true;

      // Coaches and admins can create codes
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;

      // The creator can update anything; any authenticated user can append their uid to usedBy
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy.hasAll(resource.data.usedBy)
          && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
        )
      );
    }

    match /coachInvites/{token} {
      // Anyone can read a token to validate it before registering
      allow read: if true;
      // Only admins can create invite tokens
      allow create: if isAdmin();
      // Any authenticated user can mark a token as used (one-time, append usedBy/usedAt only)
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
    }

    match /videos/{videoId} {
      // Admins have full access to all videos
      allow read, write: if isAdmin();

      // Coaches can create videos (coachId must be their own uid)
      allow create: if request.auth != null
        && request.resource.data.coachId == request.auth.uid;

      // Coaches can read, update, and delete their own videos
      allow read, update, delete: if request.auth != null
        && resource.data.coachId == request.auth.uid;

      // Coaches can read ALL videos (shared view across all coaches)
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

      // Students can read videos where they are in the studentIds array
      allow read: if request.auth != null
        && request.auth.uid in resource.data.studentIds;

      // Students can mark a video as viewed (append-only)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.studentIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        && request.resource.data.viewedBy.hasAll(resource.data.viewedBy)
        && request.resource.data.viewedBy.size() == resource.data.viewedBy.size() + 1;

      match /annotations/{annotationId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }

      match /voiceover/{docId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }

      match /comments/{commentId} {
        allow read, create: if isAdmin();
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
      }

      match /reactions/{userId} {
        allow read, write: if isAdmin();
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
        allow write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }
    }

    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin']
      );
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        resource.data.coachId == request.auth.uid
      );
      // Students can update sessions (booking/waitlist operations via transactions)
      allow update: if request.auth != null;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin']
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.studentId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin']
      );
    }

  }
}
