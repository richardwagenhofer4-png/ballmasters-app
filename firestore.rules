rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCoachOrAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['coach', 'admin'];
    }

    // ---------------------------------------------------------------------
    // Paywall (Build 1.1). The switch is config/app.paywallEnabled. While the
    // doc is missing, or the field is absent/false, paywallAllows() is true
    // and every rule that uses it evaluates exactly as it did before.
    // exists() runs first so a missing config doc never reaches get(), which
    // would error (and an error denies).
    // ---------------------------------------------------------------------
    function paywallOn() {
      return exists(/databases/$(database)/documents/config/app)
        && get(/databases/$(database)/documents/config/app).data.get('paywallEnabled', false) == true;
    }

    // The caller's effective plan is in `plans`: coaches and admins always
    // pass; anyone else needs a plan field in the set that has not expired
    // (a null planExpiresAt means no end date).
    function callerHasPlan(plans) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.get('role', '') in ['coach', 'admin']
        || (
          u.get('plan', 'none') in plans
          && (u.get('planExpiresAt', null) == null || u.get('planExpiresAt', null) > request.time)
        );
    }

    function paywallAllows(plans) {
      return !paywallOn() || callerHasPlan(plans);
    }

    // Same test the app uses (lib/entitlements.ts isDrillComparison).
    function isDrillComparison(v) {
      return v.get('type', '') == 'drill_comparison'
        || (v.get('coachVideoKey', null) != null && v.get('studentVideoKey', null) != null);
    }

    // users/{uid} plan fields only the server (Admin SDK: the RevenueCat
    // webhook, /api/admin/plan, /api/billing/refresh) may write. Keep in sync
    // with PLAN_FIELDS in lib/entitlements.ts. Locked for the owner regardless
    // of the switch: no client write touches these keys, and a
    // switch-dependent lock would let anyone pre-set plan: 'coached' on
    // themselves before launch.
    function planFields() {
      return ['plan', 'planSource', 'planExpiresAt', 'planProductId', 'planIsTrial',
              'planWillRenew', 'rcAppUserId', 'revenuecat', 'adminGrant'];
    }

    // What a user may never change on their own doc: who they are (role),
    // who coaches them (coachId), and the plan/billing fields. Admins still
    // can (the isAdmin() rule below), e.g. the Coach Assignment card.
    function selfLockedFields() {
      return planFields().concat(['role', 'coachId']);
    }

    match /users/{userId} {
      // Profiles are only created by /api/register, which decides role and
      // coachId from the invite that was used, and only deleted by
      // /api/delete-account — both via the Admin SDK, which bypasses these
      // rules. No client may create or delete a users doc, its own included
      // (otherwise delete + re-create would reset role/coachId).
      allow create, delete: if false;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(selfLockedFields());
      allow read: if request.auth != null && resource.data.role in ['coach', 'admin'];
      allow read: if request.auth != null
        && resource.data.coachId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    match /inviteCodes/{code} {
      // Single-doc lookup by known code is public (needed before Auth signup);
      // listing the collection to harvest codes is forbidden.
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
          && request.resource.data.usedBy.hasAll(resource.data.usedBy)
          && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
        )
      );
    }

    match /coachInvites/{token} {
      // Single-doc lookup by known token is public (needed before Auth signup);
      // listing the collection to harvest tokens is forbidden.
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
    }

    match /videos/{videoId} {
      allow read, write: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.coachId == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.coachId == request.auth.uid;
      // Students. With the paywall on, listing needs an active plan (Access or
      // Coached) and fetching a single drill comparison needs Coached. list is
      // deliberately type-agnostic: rules are not filters, so a type check here
      // would fail an Access athlete's whole library query instead of letting
      // the app show drill cards as locked. Listing exposes no media — playback
      // URLs are only minted server-side after a rules-checked get
      // (/api/videos/[id] reads the doc with the athlete's own token).
      allow list: if request.auth != null
        && request.auth.uid in resource.data.studentIds
        && paywallAllows(['access', 'coached']);
      allow get: if request.auth != null
        && request.auth.uid in resource.data.studentIds
        && paywallAllows(['access', 'coached'])
        && (!isDrillComparison(resource.data) || paywallAllows(['coached']));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.studentIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        && request.resource.data.viewedBy.hasAll(resource.data.viewedBy)
        && request.resource.data.viewedBy.size() == resource.data.viewedBy.size() + 1;

      // Coach breakdowns (drawings, voiceover, captions, feedback) are Coached-only for students
      // once the paywall is on. Access athletes learn a clip has one from the
      // denormalised videos/{id}.hasBreakdown flag instead.
      match /annotations/{annotationId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
          && paywallAllows(['coached']);
      }

      match /voiceover/{docId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
          && paywallAllows(['coached']);
      }

      // Captions (made from the coach's voiceover) and the coach's written
      // feedback are part of the same breakdown: exactly voiceover's access.
      // Switch off, they behave as voiceover does; switch on, students need
      // Coached.
      match /captions/{docId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
          && paywallAllows(['coached']);
      }

      match /feedback/{docId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid;
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
          && paywallAllows(['coached']);
      }

      match /comments/{commentId} {
        allow read, create: if isAdmin();
        allow read, create: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
      }

      match /reactions/{userId} {
        allow read, write: if isAdmin();
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/videos/$(videoId)).data.coachId == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds
        );
        allow write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/videos/$(videoId)).data.studentIds;
      }
    }

    // Sessions and bookings — in-app calendar retired (external booking via Play by Point).
    // Reads remain for authenticated users (coach dashboards still count past bookings for
    // lesson stats); writes are locked to admins so nobody can create/modify/delete records.
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 1-to-1 messaging threads. With the paywall on, the athlete side needs
    // Coached ("direct line to your coach"); the coach side is never gated.
    match /threads/{threadId} {
      // The thread doc is readable/writable by the coach or the athlete in the thread
      allow read, write: if request.auth != null
        && (
          resource.data.coachId == request.auth.uid
          || (resource.data.athleteId == request.auth.uid && paywallAllows(['coached']))
        );
      // Allow create when the doc doesn't exist yet — validate the ids match the caller.
      // Coach side additionally requires the caller to be the athlete's resolved
      // coach (their users.coachId, or the head coach when they have no coachId),
      // so a coach can only open a thread the athlete can actually see. The
      // athlete side is unchanged.
      allow create: if request.auth != null
        && (
          (
            request.resource.data.coachId == request.auth.uid
            && (
              get(/databases/$(database)/documents/users/$(request.resource.data.athleteId)).data.get('coachId', null) == request.auth.uid
              || (
                get(/databases/$(database)/documents/users/$(request.resource.data.athleteId)).data.get('coachId', null) == null
                && get(/databases/$(database)/documents/settings/general).data.headCoachId == request.auth.uid
              )
            )
          )
          || (request.resource.data.athleteId == request.auth.uid && paywallAllows(['coached']))
        );

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/threads/$(threadId)).data.coachId == request.auth.uid
            || (
              get(/databases/$(database)/documents/threads/$(threadId)).data.athleteId == request.auth.uid
              && paywallAllows(['coached'])
            )
          );
        allow create: if request.auth != null
          && (
            get(/databases/$(database)/documents/threads/$(threadId)).data.coachId == request.auth.uid
            || (
              get(/databases/$(database)/documents/threads/$(threadId)).data.athleteId == request.auth.uid
              && paywallAllows(['coached'])
            )
          )
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // App-wide settings — readable by any authenticated user, writable only by admins
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Feature switches (config/app: paywallEnabled, planToolsEnabled).
    // Readable by signed-in clients; flipped only from the Firebase console
    // or the Admin SDK, never from the app.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // billingEvents/{eventId} (RevenueCat webhook + admin plan grant audit
    // log) has no match on purpose: server-only via the Admin SDK.

    // In-app notifications — each user can only read/update their own; creates are
    // constrained so an authed user can't spoof a notification to themselves and
    // must use a known type. Recipient must differ from caller (nobody legitimately
    // notifies themselves — this blocks self-spam and abusive impersonation of self).
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.type in ['new_video', 'new_message', 'new_comment', 'booking', 'booking_approved', 'booking_declined']
        && request.resource.data.read == false;
    }

  }
}
